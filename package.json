{
  "name": "signalflow",
  "version": "0.0.1",
  "private": true,
  "packageManager": "pnpm@11.16.0",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "node --import tsx --test src/collector/*.test.ts src/lib/feishu/*.test.ts src/repositories/feishu/*.test.ts src/repositories/file/*.test.ts src/services/*.test.ts",
    "collector:dry-run": "tsx scripts/collect-intelligence.ts --dry-run",
    "collector:write": "tsx scripts/collect-intelligence.ts --write",
    "collector:write:domain": "tsx scripts/collect-intelligence.ts --write --track domain",
    "typecheck": "tsc --noEmit",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "dependencies": {
    "cheerio": "^1.0.0",
    "lucide-react": "^0.468.0",
    "next": "^15.5.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "rss-parser": "^3.13.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@next/eslint-plugin-next": "^15.5.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "6.1.1",
    "globals": "16.4.0",
    "tailwindcss": "4.2.1",
    "tsx": "^4.20.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3"
  },
  "type": "module"
}
